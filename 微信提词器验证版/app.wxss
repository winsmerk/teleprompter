page{background:#f5f7f6;color:#172c26;font-family:-apple-system,BlinkMacSystemFont,"Helvetica Neue",sans-serif}button{box-sizing:border-box;margin:0;padding:0 16px;min-height:48px;line-height:48px;font-size:16px;font-weight:500;border-radius:12px}button::after{border:0}button[disabled]{opacity:.45}.primary{background:#168b77;color:#fff}.secondary{background:#edf3f0;color:#215e50}.card{background:#fff;border:1px solid #ebefed;border-radius:16px}.muted{color:#718078;font-size:13px;line-height:1.6}slider{margin:0}
