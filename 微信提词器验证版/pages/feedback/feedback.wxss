.feedback-page{max-width:560px;margin:auto;padding:24px 16px calc(24px + env(safe-area-inset-bottom))}.heading{font-size:25px;font-weight:600;color:#172c26;line-height:1.4}.subtitle{font-size:14px;color:#718078;line-height:1.7;margin-top:8px}.feedback-card{margin-top:20px;padding:16px}.feedback-input{box-sizing:border-box;width:100%;height:220px;line-height:1.8;font-size:17px;color:#233d33}.feedback-placeholder{color:#97a59e}.counter{text-align:right;color:#7c8c82;font-size:12px;margin-top:12px}.feedback-notice{color:#7a887f;font-size:12px;line-height:1.8;margin-top:14px}.feedback-page button.submit-button{width:100%;min-height:56px;line-height:56px;font-size:17px;font-weight:600;margin-top:24px}.feedback-page button.privacy-link{width:100%;color:#176958;background:transparent;font-size:13px;margin-top:8px}.feedback-error{background:#fff0eb;border-radius:10px;color:#8c4c38;font-size:14px;line-height:1.7;padding:12px;margin-top:16px}.status-note{font-size:13px;color:#718078;line-height:1.7;margin-top:12px}.success-card{padding:32px 20px;margin-top:32px;text-align:center}.success-icon{width:56px;height:56px;margin-bottom:18px}
