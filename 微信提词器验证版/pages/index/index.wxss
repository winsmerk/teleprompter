.home{padding:12px 16px calc(130px + env(safe-area-inset-bottom));max-width:560px;margin:auto}.hero{margin:2px 4px 20px}.title{font-size:30px;line-height:1.35;font-weight:700;letter-spacing:-.5px}.subtitle{color:#718078;font-size:15px;margin-top:6px}.card{padding:16px;margin-bottom:12px}.section-heading{display:flex;align-items:center;justify-content:space-between;font-size:16px;font-weight:600;margin-bottom:12px}.saved-hint{font-size:11px;font-weight:400;color:#168b77}.script-input{box-sizing:border-box;width:100%;height:168px;padding:12px;border:1px solid #ebefed;border-radius:10px;font-size:17px;line-height:1.75;color:#233d33;background:#fff}.input-placeholder{color:#97a59e}.counter{text-align:right;font-size:12px;color:#7c8c82;margin-top:10px}.setting-row{display:flex;align-items:center;gap:4px;min-height:56px}.setting-label{font-size:13px;flex-shrink:0;width:64px}.step{width:48px;height:48px;min-width:48px;padding:0;font-size:24px;background:#f0f4f2;line-height:48px}.setting-slider{flex:1;min-width:36px;margin:0 2px}.setting-value{min-width:26px;font-size:14px;text-align:center;font-variant-numeric:tabular-nums}.format-row{display:flex;align-items:center;gap:8px;margin-top:10px}.segments{display:flex;gap:8px;flex:1}.segment{flex:1;min-width:0;padding:0 6px;font-size:14px;background:#f0f4f2;color:#334c40;white-space:nowrap}.segment.selected{background:#168b77;color:white;font-weight:600}.format-hint{font-size:11px;color:#7c8c82;margin-top:14px;line-height:1.6}.home-footer{position:fixed;left:0;right:0;bottom:0;background:#fff;padding:12px 16px calc(10px + env(safe-area-inset-bottom));border-top:1px solid #ebefed;z-index:5}.start-button{width:100%;height:56px;line-height:56px;font-size:18px;font-weight:600;max-width:560px;margin:auto}.camera-glyph{font-size:17px}.privacy-note{text-align:center;color:#859289;font-size:11px;margin-top:8px}.help-link{background:transparent;color:#84928a;font-size:12px;width:100%;font-weight:400}.settings-card{padding-top:14px;padding-bottom:12px}.settings-card .section-heading{margin-bottom:2px}@media(max-width:350px){.home{padding-left:12px;padding-right:12px}.card{padding:12px}.setting-label{width:56px;font-size:12px}.setting-value{min-width:22px}.setting-row{gap:2px}}

.home button.step{width:48px;min-width:48px;max-width:48px;flex:0 0 48px}.home button.segment{width:auto;flex:1;min-width:0}.home button.help-link{width:100%}.home-footer button.start-button{width:100%;max-width:560px}
.button-icon{display:inline-block;width:22px;height:22px;vertical-align:middle;margin-right:6px}.step .button-icon{margin-right:0}.segment .button-icon{width:18px;height:18px}
.entry-wait{color:#168b77;min-height:18px}.home-footer button.start-button[disabled]{background:#168b77;color:#fff;opacity:.8}

.home button.feedback-entry{width:100%;min-height:48px;line-height:48px;border:1px solid #d8e7df;color:#176958;background:#fff;font-size:15px;border-radius:12px;margin-top:16px}
